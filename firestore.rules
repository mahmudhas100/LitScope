rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for Clubs
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Allow update if user is creator or if updating members list (joining/leaving)
      allow update: if isAuthenticated(); 
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // Rules for Threads (subcollection or top-level? Code shows top-level)
    match /threads/{threadId} {
      allow read: if true; // Assuming threads are public if clubs are public
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Rules for Users/Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
